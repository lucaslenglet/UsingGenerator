<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Isolated so a repacked package with an unchanged version is never served from cache. -->
    <add key="globalPackagesFolder" value=".artifacts/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="local" value=".artifacts/feed" />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
